# app: home
# P5-3 / P5-4: the Home app from fixtures (tests/fixtures/make-ha-fixtures.py): Lights (toggles, scene, sheets), Climate, More,
# a failed call. Every action shows at once (optimistic); the tab is read again 1.5 s later (the fixture is static, so shots are
# taken before that).
wait 1500
shot home-lights
tap 480 805             # next page of the list
wait 900
shot home-lights-p2
tap 60 805
wait 900
tap 472 464             # Lounge toggle (third row, under the Sofa lamp and Whole living room): off at once
wait 300
shot home-lights-lounge-off
wait 2000
tap 180 450             # the row text of Lounge: its sheet (brightness, lamps)
wait 700
shot home-light-sheet
tap 270 120             # outside the sheet: closes it
wait 700
tap 140 181             # the Evening scene button: toast, calls go out
wait 500
shot home-scene
wait 2500
tap 268 925             # Climate tab
wait 1500
shot home-climate
tap 480 272             # thermostat: plus (21.5)
wait 400
shot home-climate-target
wait 1500
tap 433 925             # More tab
wait 1500
shot home-more
tap 472 268             # Air conditioning toggle: the service call fails (fixture status 500): reverts, toast
wait 700
shot home-more-failed
wait 35000              # foreground polling: touched within 2 minutes, so the tab is read again every 30 s
tap 270 600             # a touch on nothing (the idle time counts from it)
wait 30000
expect-state Updated 13:35
shot home-polled
swipe 270 20 270 400    # the quick panel with Wi-Fi up (the Home refresh brought it up)
wait 700
shot quick-panel-online
