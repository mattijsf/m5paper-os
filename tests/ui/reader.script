# app: read
# P4-1: opens the fixture book (TXT), turns pages. Page turns are plain Fast/Text passes, never a Quality flash.
wait 600
tap 270 178             # the one book in the library
wait 1500
shot reader-p1
tap 400 500             # right 40%: next
wait 900
expect-no-quality
shot reader-p2
tap 400 500
wait 900
tap 400 500
wait 900
swipe 400 600 100 600   # swipe left: next
wait 900
tap 400 500
wait 900
expect-no-quality
shot reader-p6
tap 60 500              # left 25%: back
wait 900
swipe 100 600 400 600   # swipe right: back
wait 900
expect-no-quality
shot reader-p4
expect-state page=4/
# The position survives a restart (progress is saved when the app closes).
tap 400 500
wait 900
tap 400 500
wait 900
tap 400 500
wait 900
shot reader-p7
restart                 # back to the library, the book is now the "continue" card
wait 600
tap 400 320
wait 1500
expect-state page=7/
shot reader-p7-resumed
expect-shot-equal reader-p7 reader-p7-resumed
# Paging to the last page: no crash, the footer ends on N / N.
page-through 200
shot reader-last
tap 400 500             # the last page: next does nothing
wait 900
expect-state page=33/33
