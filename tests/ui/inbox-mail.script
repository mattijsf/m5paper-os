# app: mail
# P6-4 since D22: the Mail list from the phone's Proton Mail notifications (sender, subject, the preview the notification showed),
# and one mail: the preview only, no full text. The 9-day-old mail is dropped (7 days at most).
wait 1500
shot mail-list
tap 270 178             # the newest mail
wait 1500
shot mail-detail
back
wait 900
tap 270 918             # Mark all read: no question, the mails are cleared, back to the launcher (no badge on Mail)
wait 1200
shot mail-markall-launcher
tap 100 424             # Mail again: nothing left
wait 1500
expect-state rows=0
