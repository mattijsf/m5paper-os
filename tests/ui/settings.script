# Settings: the list, then every section. Changes are plain Fast passes; "Clean screen now" is the one Quality flash.
wait 300
tap 270 424             # launcher: Settings tile
wait 300
shot settings-list
tap 270 172             # Wi-Fi
wait 900
shot settings-wifi
back
wait 900
tap 270 268             # Display
wait 900
shot settings-display
tap 480 305             # ghost limit: +
tap 480 305
wait 100
expect-no-quality
tap 430 420             # settle delay: 1000 ms
wait 900
expect-no-quality
shot settings-display-changed
tap 270 150             # Clean screen now: the one Quality refresh
wait 900
shot settings-display-cleaned
back
wait 900
tap 270 364             # Power
wait 900
shot settings-power
tap 470 200             # switch off after: Never
wait 900
shot settings-power-never
back
wait 900
tap 270 460             # Reading
wait 900
shot settings-reading
back
wait 900
tap 270 556             # Home Assistant
wait 900
shot settings-ha
tap 270 555             # Test connection: GET /api/ with the token (fixture in the simulator)
wait 600
shot settings-ha-tested
back
wait 900
tap 270 652             # Storage
wait 900
shot settings-storage
back
wait 900
tap 270 748             # Developer
wait 900
shot settings-developer
tap 140 845             # Sleep test: light sleep, then a toast says what woke the device
wait 300
shot settings-developer-sleep
wait 3300
tap 396 845             # Power off: a confirmation sheet (nothing is powered off in the test)
wait 900
shot settings-developer-poweroff
tap 270 300             # outside the sheet: closes it
wait 900
back
wait 900
tap 270 844             # About
wait 900
shot settings-about
