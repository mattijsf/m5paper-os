# app: vijfje
# time: 2028-01-20T09:00:00
# rtc: unset
# Vijfje with a lost clock (battery ran flat): no word, the button "Klok zetten". Without Wi-Fi it says so; with Wi-Fi it
# joins, the time sync sets the clock and the day's board comes (day 430, as in vijfje.script).
wait 1500
shot vijfje-noclock
expect-state view=noclock
wifi off
tap 270 412              # Klok zetten, no Wi-Fi
wait 3000
shot vijfje-clock-failed
expect-state view=noclock
wifi on
tap 270 380              # Klok zetten again (one hint line less: the button moved up)
wait 4000
shot vijfje-clock-set
expect-state view=play day=430
