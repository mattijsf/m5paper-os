# app: whatsapp
# A reply when Home Assistant has no relay script (fixture ha-empty: the push answers 400): a toast, and the text stays.
wait 1500
tap 270 178             # Family (saved from an earlier fetch)
wait 900
tap 270 918             # Reply
wait 900
type Hello
wait 600
tap 400 504             # Send
wait 900
tap 270 812             # Send in the sheet
wait 1500
expect-state chars=5
shot whatsapp-send-missing
