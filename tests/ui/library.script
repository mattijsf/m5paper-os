# app: read
# P4-2: the library. Nine books, none opened yet: a plain list; after reading one, it moves to the "continue" card.
wait 600
shot library-fresh
tap 270 150
wait 2500                # the footer's page number settles after the page (Page goes first)
shot library-opened-book
tap 400 500
wait 900
tap 400 500
wait 900
tap 270 500             # centre: the menu
wait 600
shot library-menu
tap 432 900             # Library
wait 900
shot library-recent     # the book just read is the card on top, with its progress
tap 480 925             # next page of the list
wait 900
shot library-recent-p2
tap 60 925              # previous page (the card is back)
wait 900
expect-state books=9|A Baker's Morning|Bram Stone|33
tap 400 320             # Continue: the book opens on the page it was left on
wait 2500
expect-state page=3/7
shot library-continued
