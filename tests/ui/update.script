# app: settings
# P7-3: Update over Wi-Fi (Settings > About, D37). The page joins Wi-Fi, listens for a signed firmware package from the Mac
# (`make ota`) and shows the address. Leaving it stops listening.
wait 800
tap 270 857             # About
wait 900
tap 270 568             # Update over Wi-Fi
wait 3000
shot update-page
expect-state running
back
wait 900
