# app: vijfje
# time: 2028-01-22T09:00:00
# Vijfje fetches more accepted words (tests/fixtures/http/GET_woordscore.nl_woordlijst.txt.json: two words in the first
# part, which is not used, four in the second). "tjalk" is not a built-in word: refused before the list is there is not
# tested (timing), accepted once it is. Then Wi-Fi off and a restart: the words come from the cache, the game works offline.
wait 3000
expect-state list=4;
tap 147 708             # eerst: in the first part of the file and built in, so known anyway
wait 300
tap 147 708
wait 300
tap 196 708
wait 300
tap 122 788
wait 300
tap 245 708
wait 300
tap 61 868             # enter
wait 900
expect-state tries=1
tap 245 708             # tjalk: only in the fetched list
wait 300
tap 367 788
wait 300
tap 73 788
wait 300
tap 465 788
wait 300
tap 416 788
wait 300
tap 61 868             # enter
wait 900
expect-state tries=2
expect-state guesses=eerst,tjalk;
shot vijfje-list-word
tap 504 92              # the info button
wait 900
shot vijfje-list-stats
expect-state view=stats
back
wait 900
wifi off
restart
wait 1500
expect-state list=4;
expect-state guesses=eerst,tjalk;
tap 122 868             # offline: a word of the cached list (also built in)
wait 300
tap 441 708
wait 300
tap 416 868
wait 300
tap 147 708
wait 300
tap 196 708
wait 300
tap 61 868             # enter
wait 900
expect-state tries=3
