# app: widgets4
# P2-7: the keyboard types a 12-character password with letters, a capital, digits and symbols. Every key
# press pushes at most 6000 pixels (just the changed part of the text field).
wait 200
shot keyboard-empty
type-max 6000 Passw0rd!2x?
wait 900
expect-no-quality
shot keyboard-typed
tap 498 855             # backspace
wait 900
shot keyboard-backspace
tap 40 927              # 123 key
wait 900
shot keyboard-symbols
long 270 104            # masked field: Paste and Clear only, never Copy
wait 900
shot keyboard-menu-masked
tap 270 100             # outside the sheet: it closes
wait 900
shot keyboard-menu-closed
tap 498 855 200         # backspace with a real finger (200 ms down: the key shows pressed, then goes back, and a bullet
wait 900                # leaves the field): small pushes at the key and at the field, not one box from the field to the key
expect-max-pushed 30000
