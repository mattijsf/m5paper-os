# app: pixelpuzzle
# time: 2026-11-20T09:00:00
# Pixelpuzzel 1 (2026-11-20, the heart). Start; taps fill one cell, swipes a stretch of a row or column, Kruisje crosses,
# a long press puts the other mark, a tap on a filled cell empties it; met clues turn gray; pause and Verder; the solve shows
# the picture and its name; Kopieer score.
wait 1000
shot pixelpuzzle-ready
expect-state view=ready
tap 270 420             # Start
wait 900
shot pixelpuzzle-play
expect-state view=play
expect-state name=Een_hart
expect-state grid=127,182
tap 187 242
wait 300
tap 227 242
wait 300
tap 427 242
wait 300
tap 467 242
wait 300
swipe 147 282 267 282    # row 2: four cells in one swipe
wait 300
swipe 387 282 507 282
wait 300
swipe 147 322 507 322    # row 3: the whole row
wait 300
tap 347 322             # a filled cell tapped again: empty
wait 300
expect-state filled=21
expect-state crossed=0
tap 347 322
wait 300
long 147 202            # a long press in Vullen: a cross
wait 900
tap 400 683           # Kruisje
wait 300
swipe 507 202 187 202    # row 0 crossed from the other end (the long-pressed cell is not taken away: the first cell decides)
wait 300
expect-state filled=22
expect-state crossed=10
expect-state mode=1
swipe 147 402 147 562    # a column swipe: column 0, rows 5 to 9 crossed
wait 300
expect-state crossed=15
shot pixelpuzzle-midway
tap 140 683           # Vullen
wait 300
swipe 147 362 507 362
wait 300
swipe 187 402 467 402
wait 300
swipe 227 442 427 442
wait 300
tap 504 92            # pause
wait 900
expect-state view=ready
tap 270 420           # Verder
wait 900
expect-state view=play
expect-state filled=46
swipe 267 482 387 482
wait 300
tap 307 522
wait 300
tap 347 522
wait 1500
shot pixelpuzzle-done
expect-state view=done
tap 270 649             # Kopieer score
wait 600
shot pixelpuzzle-copied
